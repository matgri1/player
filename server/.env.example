# Copy to .env and fill in. Never commit .env.
PORT=3100

# PostgreSQL. Can be the same server as QUY Travel, ideally a separate database or user.
DATABASE_URL=postgres://kuy:CHANGE_ME@127.0.0.1:5432/kuy

# Long random string for signing admin sessions: openssl rand -hex 32
SESSION_SECRET=

# Admin login. Create the hash with: npm run hash-password
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=

# Telegram notifications about new requests (optional, test bot for now)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Public site address(es) allowed to send requests, comma-separated (empty = same host only)
PUBLIC_ORIGIN=

# Set to 1 when running behind nginx
TRUST_PROXY=1

# Folder with the public site (served at /)
SITE_DIR=../kuy

# Admin panel link used in Telegram notifications
ADMIN_URL=
